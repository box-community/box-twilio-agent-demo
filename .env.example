# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Box Client Credentials Grant (CCG) + destination folder
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_FOLDER_ID=0
# Optional: assign each review task to this Box user
BOX_REVIEWER_USER_ID=

# Twilio Agent Connect (required by `npm run voice`)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=+15555550100
# Optional on Vercel (the production hostname is detected automatically).
# Required locally: host only, without https:// or a path.
TWILIO_VOICE_PUBLIC_DOMAIN=

# Optional local voice server settings. Vercel supplies PORT automatically.
PORT=8080
HOST=0.0.0.0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Box Client Credentials Grant (CCG) + destination folder
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_FOLDER_ID=0
# Optional: assign each review task to this Box user
BOX_REVIEWER_USER_ID=

# Twilio Agent Connect (required by `npm run voice`)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=+15555550100
TWILIO_CONVERSATION_CONFIGURATION_ID=conv_configuration_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Host only; do not include https:// or a path
TWILIO_VOICE_PUBLIC_DOMAIN=your-tunnel.ngrok.app

# Optional voice server settings
PORT=8080
HOST=0.0.0.0
